## 1. 三方 leading edge (core_enrichment)
get_leading <- function(gsea_df, pid) {
row <- gsea_df %>% dplyr::filter(ID == pid)
if (nrow(row) == 0 || is.na(row$core_enrichment[1])) return(character(0))
strsplit(row$core_enrichment[1], "/")[[1]]
}
le_rna   <- get_leading(rea_rna,   target_id)
le_prot  <- get_leading(rea_prot,  target_id)
le_orbit <- get_leading(rea_orbit, target_id)
cat("LE  RNA:", length(le_rna), "| Prot:", length(le_prot), "| ORBIT:", length(le_orbit), "\n")
all_genes <- unique(c(le_rna, le_prot, le_orbit))
cat("Union LE:", length(all_genes), "\n")
## 2. 每个基因的 logFC + padj
rna_data <- deg_rna %>% dplyr::filter(gene_symbol %in% all_genes) %>%
dplyr::arrange(adj.P.Val) %>% dplyr::distinct(gene_symbol, .keep_all = TRUE) %>%
dplyr::select(Gene = gene_symbol, RNA_logFC = logFC, RNA_padj = adj.P.Val)
prot_data <- prot %>% dplyr::filter(Gene_name %in% all_genes) %>%
dplyr::arrange(Adj_pvalue) %>% dplyr::distinct(Gene_name, .keep_all = TRUE) %>%
dplyr::select(Gene = Gene_name, Prot_logFC = LogFC, Prot_padj = Adj_pvalue)
gene_table <- data.frame(Gene = all_genes) %>%
dplyr::left_join(rna_data,  by = "Gene") %>%
dplyr::left_join(prot_data, by = "Gene") %>%
dplyr::mutate(in_RNA = Gene %in% le_rna, in_Prot = Gene %in% le_prot, in_ORBIT = Gene %in% le_orbit,
n_omic = in_RNA + in_Prot + in_ORBIT) %>%
dplyr::arrange(desc(n_omic), RNA_padj)
cat("\n======== gene-level ========\n"); print(gene_table)
## 3. 排序 (RNA端 -> 中心 -> Protein端 -> ORBIT only)
gene_table <- gene_table %>%
dplyr::mutate(
le_pattern = paste0(ifelse(in_RNA,"R",""), ifelse(in_Prot,"P",""), ifelse(in_ORBIT,"O","")),
le_order = match(le_pattern, c("R","RO","RP","RPO","PO","P","O"))) %>%
dplyr::arrange(le_order, desc(RNA_logFC))
gene_order <- gene_table$Gene
## 4. 长格式
plot_long <- gene_table %>%
dplyr::select(Gene, RNA_logFC, RNA_padj, Prot_logFC, Prot_padj) %>%
pivot_longer(-Gene, names_to = c("Omic", ".value"), names_pattern = "(.+)_(.+)") %>%
dplyr::filter(!is.na(logFC) & !is.na(padj)) %>%
dplyr::mutate(
neg_log_padj = pmin(-log10(pmax(padj, 1e-300)), 6),   # ← 先封顶到 6, 强信号不丢
Omic = factor(Omic, levels = c("RNA","Prot"), labels = c("RNA","Protein")),
Gene = factor(Gene, levels = rev(gene_order)))
## 5. 气泡图
p <- ggplot(plot_long, aes(x = Omic, y = Gene)) +
geom_point(aes(fill = logFC, size = neg_log_padj),
shape = 21, color = "black", stroke = 0.6, alpha = 0.9) +
scale_fill_gradient2(low = "#2166AC", mid = "white", high = "#B2182B",
midpoint = 0, name = expression(log[2]~FC)) +
scale_size_continuous(range = c(2, 10), name = expression(-log[10]~adj.P),
breaks = c(0.1, 0.5, 1.0, 5), limits = c(0, 6)) +
scale_x_discrete(limits = c("RNA","Protein"),
labels = c("RNA" = "Transcriptome", "Protein" = "Proteome")) +
theme_bw(base_size = 13, base_family = "Arial") +
theme(panel.grid.major = element_blank(), panel.grid.minor = element_blank(),
axis.text.y = element_text(face = "bold", size = 15),
axis.text.x = element_text(size = 18, face = "bold"),
plot.title  = element_text(face = "bold", hjust = 0.5, size = 18),
legend.position = "right", legend.title = element_text(size = 11, face = "bold")) +
labs(title = plot_title, x = NULL, y = NULL)
p
## 6. dashed 圆角框 (RNA / Protein / ORBIT core)
y_levels  <- levels(plot_long$Gene); gene_ypos <- setNames(seq_along(y_levels), y_levels)
find_runs <- function(pos) {
if (length(pos) == 0) return(data.frame(start = integer(), end = integer()))
pos <- sort(pos); if (length(pos) == 1) return(data.frame(start = pos, end = pos))
brk <- which(diff(pos) > 1)
data.frame(start = pos[c(1, brk + 1)], end = pos[c(brk, length(pos))])
}
rna_runs   <- find_runs(unname(gene_ypos[names(gene_ypos) %in% le_rna]))   %>% mutate(xmin=0.6, xmax=1.4, core="RNA core")
prot_runs  <- find_runs(unname(gene_ypos[names(gene_ypos) %in% le_prot]))  %>% mutate(xmin=1.6, xmax=2.4, core="Protein core")
orbit_runs <- find_runs(unname(gene_ypos[names(gene_ypos) %in% le_orbit])) %>% mutate(xmin=0.7, xmax=2.3, core="ORBIT core")
rect_data  <- bind_rows(rna_runs, prot_runs, orbit_runs) %>%
mutate(ymin = start - 0.5, ymax = end + 0.5,
core = factor(core, levels = c("RNA core","Protein core","ORBIT core")))
get_padj <- function(gsea_df, pid) {
v <- gsea_df %>% dplyr::filter(ID == pid) %>% dplyr::pull(p.adjust); if (length(v) == 0) NA else v[1]
}
padj_rna <- get_padj(rea_rna, target_id); padj_prot <- get_padj(rea_prot, target_id); padj_orbit <- get_padj(rea_orbit, target_id)
cat(sprintf("\nadj.P  RNA: %.4f | Protein: %.4f | ORBIT: %.4f\n", padj_rna, padj_prot, padj_orbit))
fmt_p <- function(p) if (is.na(p)) "NA" else sprintf("%.3f", p)
p2 <- p +
statebins:::geom_rrect(
data = rect_data,
aes(xmin = xmin, xmax = xmax, ymin = ymin, ymax = ymax, color = core),
fill = NA, linetype = "dashed", size = 1.5, radius = grid::unit(20, "pt"),
inherit.aes = FALSE) +
scale_color_manual(
name = "Pathway core (adjusted P)",
values = c("RNA core" = "#4DAF4A", "Protein core" = "#377EB8", "ORBIT core" = "#E41A1C"),
labels = c("RNA core"     = sprintf("Transcriptome (%s)", fmt_p(padj_rna)),
"Protein core" = sprintf("Proteome (%s)",      fmt_p(padj_prot)),
"ORBIT core"   = sprintf("ORBIT (%s)",         fmt_p(padj_orbit))),
breaks = c("RNA core","Protein core","ORBIT core"),
guide  = guide_legend(override.aes = list(fill = NA, linetype = "dashed", size = 1.5))) +
theme(legend.title = element_text(size = 15, face = "bold"),
legend.text = element_text(size = 13),
legend.key.size = unit(1, "cm"), legend.spacing.y = unit(1, "cm"))
p2
