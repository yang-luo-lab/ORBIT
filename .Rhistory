Feature, N,
RNA_logFC, RNA_P, Prot_logFC, Prot_P,
k = (!is.na(RNA_P)) + (!is.na(Prot_P)),                       # 有几个组学有 P
fisher_P = pchisq(                                            # 缺失不计入；单组学=原始 P
-2 * (coalesce(log(pmax(RNA_P,  .Machine$double.xmin)), 0) +
coalesce(log(pmax(Prot_P, .Machine$double.xmin)), 0)),
df = 2 * k, lower.tail = FALSE),
mean_logFC = rowMeans(cbind(RNA_logFC, Prot_logFC), na.rm = TRUE),  # 缺一个取另一个
direction  = sign(mean_logFC)
) %>%
mutate(fisher_adjP = p.adjust(fisher_P, method = "BH"))
head(tubu_fisher)
View(tubu_fisher)
library(clusterProfiler); library(dplyr); library(tidyr)
## ===== 1. 一张源表，凑齐 4 条 geneList 需要的列 =====
gl_src <- ORBITMasterTable_Tubu_CKDvsHealthy %>%
transmute(
Feature,
RNA_t,                                # RNA 直接用 t
Prot_dir = sign(Prot_logFC), Prot_P,  # 蛋白：sign × -log10(P)
ORBIT_dir = Direction, ORBIT_P = P
) %>%
left_join(tubu_fisher %>% transmute(Feature, Fisher_dir = direction, Fisher_P = fisher_P),
by = "Feature")
## ===== 2. 两种构建方式 =====
make_signed <- function(df, dir_col, p_col) {            # sign × -log10(P)
d <- df[[dir_col]]
v <- d * -log10(pmax(df[[p_col]], .Machine$double.xmin))
names(v) <- df$Feature
sort(v[is.finite(v) & d %in% c(-1, 1)], decreasing = TRUE)
}
make_raw <- function(df, val_col) {                      # 直接用原始统计量
v <- df[[val_col]]; names(v) <- df$Feature
sort(v[is.finite(v)], decreasing = TRUE)
}
geneLists <- list(
RNA     = make_raw(gl_src, "RNA_t"),
Protein = make_signed(gl_src, "Prot_dir", "Prot_P"),
Fisher  = make_signed(gl_src, "Fisher_dir", "Fisher_P"),
ORBIT   = make_signed(gl_src, "ORBIT_dir",  "ORBIT_P")
)
sapply(geneLists, length)        # 看各自排了多少基因（RNA 通常最多，蛋白最少）
## ===== 3. 跑 GSEA =====
gsea_tubu <- Map(function(gl, lab) run_gsea_4(gl, pathway_list, lab),
geneLists, names(geneLists))
## 显著通路数：collection × 方法
gsea_tidy %>% filter(p.adjust < 0.05) %>%
dplyr::count(collection, method) %>%
pivot_wider(names_from = method, values_from = n, values_fill = 0)
gsea_tidy <- bind_rows(lapply(names(gsea_tubu), function(meth)
bind_rows(lapply(names(gsea_tubu[[meth]]), function(coll) {
df <- as.data.frame(gsea_tubu[[meth]][[coll]])
if (!nrow(df)) return(NULL)
transmute(df, method = meth, collection = coll, ID, Description, NES, pvalue, p.adjust)
}))))
