library(dplyr); library(ComplexHeatmap); library(grid); library(extrafont)
loadfonts(quiet = TRUE)
font_use <- "Arial"
plot_upset_styled <- function(gsea_res, db = "Reactome",
file = "reactome_upset.pdf", side = 8, alpha = 0.05) {
sig <- function(track) gsea_res[[track]][[db]]@result %>% filter(p.adjust < alpha) %>% pull(ID)
upset_list <- list(
ORBIT         = sig("ORBIT_Rank"),   # 注意: glom 对象里这一轨叫 ORBIT_Rank
Proteome      = sig("Protein"),
Transcriptome = sig("RNA")
)
cat("Significant", db, "(adj.P<", alpha, "):\n"); print(lengths(upset_list))
m        <- make_comb_mat(upset_list)
comb_ord <- order(-comb_size(m))
set_ord  <- c("ORBIT", "Proteome", "Transcriptome")
set_cols <- c(ORBIT = "#E41A1C", Proteome = "#377EB8", Transcriptome = "#4DAF4A")
ht <- UpSet(
m,
set_order  = set_ord,
comb_order = comb_ord,
pt_size = unit(5, "mm"), lwd = 2.5,
comb_col = "grey20", bg_col = "grey95", bg_pt_col = "grey80",
height = unit(3.9, "cm"),
top_annotation = HeatmapAnnotation(
"Pathways in intersection" = anno_barplot(
comb_size(m), border = FALSE, gp = gpar(fill = "grey20", col = NA),
height = unit(14, "cm"), add_numbers = TRUE, numbers_rot = 0,
numbers_gp = gpar(fontfamily = font_use, fontsize = 18),
axis_param = list(gp = gpar(fontfamily = font_use, fontsize = 18))),
annotation_name_side = "left", annotation_name_rot = 90,
annotation_name_gp = gpar(fontfamily = font_use, fontsize = 20),
annotation_name_offset = unit(20, "mm")),
right_annotation = NULL,
left_annotation = rowAnnotation(
"Total pathways" = anno_barplot(
set_size(m), border = FALSE,
gp = gpar(fill = set_cols[set_ord], col = NA),
width = unit(4, "cm"), add_numbers = TRUE,
numbers_gp = gpar(fontfamily = font_use, fontsize = 16),
axis_param = list(gp = gpar(fontfamily = font_use, fontsize = 16),
direction = "reverse", labels_rot = 0)),
labels = anno_text(
set_ord, gp = gpar(fontfamily = font_use, fontsize = 18),
just = "center", location = unit(0.5, "npc"),
width = max_text_width(set_ord, gp = gpar(fontfamily = font_use, fontsize = 18)) +
unit(6, "mm")),
annotation_name_gp = gpar(fontfamily = font_use, fontsize = 16),
annotation_name_side   = c("Total pathways" = "bottom", "labels" = "bottom"),
annotation_name_rot    = c("Total pathways" = 0, "labels" = 0),
annotation_name_offset = unit(10, "mm"),
show_annotation_name   = c("Total pathways" = TRUE, "labels" = FALSE)),
show_row_names = FALSE
)
quartz(type = "pdf", file = file, width = side, height = side, family = font_use)
draw(ht)
dev.off()
message(">>> ", file)
invisible(upset_list)
}
